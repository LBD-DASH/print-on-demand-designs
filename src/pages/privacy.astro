---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy policy" description="Privacy policy for Open Ink Studio: a static site with no accounts, forms, payments or tracking cookies set by us." path="privacy/">
  <div class="wrap page-body"><h1>Privacy policy</h1>
    <div class="read">
      <p><strong>Last updated:</strong> 20 Nov 2026</p>
      <ul>
        <li>This is a static website. It has no accounts, forms, comments or checkout, and we collect no personal data.</li>
        <li>We do not set tracking or advertising cookies.</li>
        <li>The site is hosted on GitHub Pages. GitHub may log technical data such as IP addresses; see GitHub's privacy statement.</li>
        <li>Links to other sites (such as print-on-demand providers) are governed by those sites' own policies.</li>
        <li>If we add enquiries, payments or analytics, we will update this page first.</li>
      </ul>
    </div></div>
</Base>
