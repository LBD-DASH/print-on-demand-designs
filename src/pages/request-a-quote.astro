---
import Base from '../layouts/Base.astro';
---
<Base title="Request a quote" description="Enquiries for original print-on-demand designs are opening soon. No orders, payments or forms are live yet." path="request-a-quote/">
  <div class="wrap page-body"><h1>Request a quote</h1>
    <div class="read">
      <p class="note"><strong>Enquiries opening soon.</strong> There is no contact form, email address or checkout on this site yet, and no payment is taken.</p>
      <p>When enquiries open, this page will explain how to ask about a design and how quotes work. Until then there is nothing to submit. Please check back later.</p>
    </div></div>
</Base>
